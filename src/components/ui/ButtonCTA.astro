---
import { siteConfig } from '../../config/site-content';

interface Props {
  label: string;
  customDraft?: string;
  variant?: 'whatsapp' | 'secondary';
  className?: string;
}

const { 
  label, 
  customDraft = siteConfig.whatsapp.defaultDraft, 
  variant = 'whatsapp',
  className = '' 
} = Astro.props;

const encodedMessage = encodeURIComponent(customDraft);
const targetUrl = `https://wa.me/${siteConfig.whatsapp.phoneDigits}?text=${encodedMessage}`;

const baseStyles = "group inline-flex items-center justify-center gap-2.5 rounded-xl px-6 py-4 text-sm font-semibold transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 active:scale-95 cursor-pointer";

const variantStyles = {
  whatsapp: "bg-[#25D366] text-white shadow-[0_4px_14px_0_rgba(37,211,102,0.39)] hover:bg-[#20ba5a] hover:shadow-[0_6px_20px_rgba(37,211,102,0.5)] hover:-translate-y-0.5 focus-visible:outline-[#25D366]",
  secondary: "bg-white/90 backdrop-blur-sm text-[#1A1A1A] border border-[#4A6B5D]/20 shadow-sm hover:bg-white hover:border-[#4A6B5D] hover:shadow-md hover:-translate-y-0.5 focus-visible:outline-[#4A6B5D]"
};
---

<a
  href={targetUrl}
  target="_blank"
  rel="noopener noreferrer"
  class={`${baseStyles} ${variantStyles[variant]} ${className}`}
  aria-label={`${label} (Opens in WhatsApp)`}
>
  {variant === 'whatsapp' && (
    <svg class="h-5 w-5 fill-current transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.414 2.56 1.201 3.633l-.841 3.072 3.146-.826c1.037.728 2.296 1.15 3.627 1.15 3.183 0 5.769-2.586 5.77-5.767 0-3.181-2.587-5.768-5.768-5.768zm0 13.064c-1.12 0-2.217-.354-3.136-.988l-.225-.155-2.331.611.621-2.271-.166-.264c-.694-1.102-1.061-2.381-1.06-3.703.001-3.811 3.102-6.912 6.914-6.912 3.812 0 6.914 3.102 6.914 6.913 0 3.812-3.102 6.913-6.914 6.913zm3.785-5.181c-.207-.104-1.228-.606-1.418-.675-.19-.069-.328-.104-.467.104-.138.207-.536.675-.658.814-.121.138-.242.156-.449.052-.207-.104-.874-.322-1.666-1.028-.616-.55-1.033-1.229-1.154-1.437-.121-.207-.013-.319.091-.423.094-.093.207-.242.311-.363.104-.121.138-.207.207-.346.069-.138.035-.259-.017-.363-.052-.104-.467-1.125-.64-1.539-.168-.403-.339-.348-.467-.354-.121-.006-.259-.007-.397-.007-.138 0-.363.052-.553.259-.19.207-.726.709-.726 1.729 0 1.02.744 2.006.848 2.145.104.138 1.464 2.235 3.548 3.135.496.214.883.342 1.184.438.498.159.952.136 1.311.082.403-.06 1.228-.501 1.401-.986.173-.485.173-.901.121-.986-.052-.086-.19-.138-.397-.242z"/>
    </svg>
  )}
  <span class="tracking-wide">{label}</span>
</a>