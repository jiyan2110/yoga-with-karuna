---
import { siteConfig } from '../../config/site-content';

const encodedMessage = encodeURIComponent(siteConfig.whatsapp.defaultDraft);
const targetUrl = `https://wa.me/${siteConfig.whatsapp.phoneDigits}?text=${encodedMessage}`;
---

<div class="fixed bottom-6 right-6 z-50 flex items-center group">
  <!-- Glowing pulse background effect -->
  <div class="absolute -inset-1 rounded-full bg-[#25D366] opacity-40 blur animate-pulse group-hover:opacity-75 transition duration-300"></div>
  
  <a
    href={targetUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="relative flex items-center gap-2.5 rounded-full bg-[#25D366] p-4 sm:px-6 sm:py-4 text-white shadow-2xl transition-all duration-300 hover:bg-[#20ba5a] hover:scale-105 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366]"
    aria-label="Chat directly with Karuna on WhatsApp"
  >
    <svg class="h-6 w-6 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.414 2.56 1.201 3.633l-.841 3.072 3.146-.826c1.037.728 2.296 1.15 3.627 1.15 3.183 0 5.769-2.586 5.77-5.767 0-3.181-2.587-5.768-5.768-5.768zm0 13.064c-1.12 0-2.217-.354-3.136-.988l-.225-.155-2.331.611.621-2.271-.166-.264c-.694-1.102-1.061-2.381-1.06-3.703.001-3.811 3.102-6.912 6.914-6.912 3.812 0 6.914 3.102 6.914 6.913 0 3.812-3.102 6.913-6.914 6.913zm3.785-5.181c-.207-.104-1.228-.606-1.418-.675-.19-.069-.328-.104-.467.104-.138.207-.536.675-.658.814-.121.138-.242.156-.449.052-.207-.104-.874-.322-1.666-1.028-.616-.55-1.033-1.229-1.154-1.437-.121-.207-.013-.319.091-.423.094-.093.207-.242.311-.363.104-.121.138-.207.207-.346.069-.138.035-.259-.017-.363-.052-.104-.467-1.125-.64-1.539-.168-.403-.339-.348-.467-.354-.121-.006-.259-.007-.397-.007-.138 0-.363.052-.553.259-.19.207-.726.709-.726 1.729 0 1.02.744 2.006.848 2.145.104.138 1.464 2.235 3.548 3.135.496.214.883.342 1.184.438.498.159.952.136 1.311.082.403-.06 1.228-.501 1.401-.986.173-.485.173-.901.121-.986-.052-.086-.19-.138-.397-.242z"/>
    </svg>
    <span class="hidden sm:inline font-bold text-xs tracking-wider uppercase">Message Karuna</span>
  </a>
</div>