---
import Icon from './Icon.astro';
import { whatsappLink } from '../../config/site-content';
---

<!-- Appears after the hero, hides near the contact section so it never covers the main buttons. -->
<a
  id="floating-wa"
  href={whatsappLink()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Karuna on WhatsApp"
  class="fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))] z-40 flex h-14 w-14 translate-y-24 items-center justify-center rounded-full bg-[#1a9e4f] text-white opacity-0 shadow-[0_12px_30px_-8px_rgb(26_158_79/0.6)] transition duration-300 hover:scale-105 sm:right-6 sm:bottom-6 [&.is-shown]:translate-y-0 [&.is-shown]:opacity-100"
>
  <Icon name="whatsapp" class="h-7 w-7" />
</a>

<script>
  const btn = document.getElementById('floating-wa');
  const hero = document.getElementById('top');
  const contact = document.getElementById('contact');
  const footer = document.querySelector('footer');
  if (btn && hero) {
    const visible = new Set<Element>();
    const update = () => {
      const show = !visible.has(hero) && !visible.has(contact!) && !visible.has(footer!);
      btn.classList.toggle('is-shown', show);
      btn.toggleAttribute('inert', !show);
      btn.setAttribute('tabindex', show ? '0' : '-1');
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visible.add(e.target) : visible.delete(e.target)));
      update();
    }, { threshold: 0.15 });
    [hero, contact, footer].forEach((el) => el && io.observe(el));
  }
</script>
