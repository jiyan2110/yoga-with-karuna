---
import { siteConfig } from '../../config/site-content';
---

<section id="reviews" class="py-16 md:py-24 bg-white border-b border-[#4A6B5D]/15 scroll-mt-20 overflow-hidden">
  <div class="mx-auto max-w-[1200px] px-6">
    
    <!-- Section Header -->
    <div class="max-w-2xl mb-10 md:mb-14">
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#4A6B5D] mb-3">
        <span>Local Student Proof</span>
      </div>
      <h2 class="font-serif text-3xl font-bold tracking-tight text-[#1A1A1A] sm:text-4xl">
        Real Transformations From <span class="text-[#4A6B5D] italic">{siteConfig.location.city}</span> Residents
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#1A1A1A]/75">
        Here is what students from Anand and surrounding neighborhoods experience when they join our dedicated offline studio practice.
      </p>
    </div>

    <!-- CSS Scroll-Snap Swipeable Grid -->
    <div class="flex gap-6 overflow-x-auto pb-6 snap-x snap-mandatory lg:grid lg:grid-cols-3 lg:overflow-visible lg:pb-0 no-scrollbar">
      {siteConfig.testimonials.map((review) => (
        <div class="min-w-[280px] sm:min-w-[340px] lg:min-w-0 flex-1 snap-start rounded-2xl bg-[#FAF9F6] border border-[#4A6B5D]/15 p-6 sm:p-8 flex flex-col justify-between shadow-sm">
          
          <div>
            <!-- Star Rating Badge -->
            <div class="flex items-center gap-1 text-[#25D366] mb-4">
              {'★'.repeat(5)}
            </div>

            <!-- Quote Text -->
            <blockquote class="text-sm sm:text-base leading-relaxed text-[#1A1A1A]/85 italic">
              "{review.reviewText}"
            </blockquote>
          </div>

          <!-- Student Meta -->
          <div class="mt-6 pt-4 border-t border-black/5 flex items-center justify-between">
            <div>
              <p class="font-serif font-bold text-sm text-[#1A1A1A]">{review.studentName}</p>
              <p class="text-[11px] font-semibold text-[#4A6B5D]">{review.locality}, Anand</p>
            </div>
            <span class="rounded-full bg-black/5 px-2.5 py-1 text-[10px] font-medium text-[#1A1A1A]/60">
              {review.batchJoined}
            </span>
          </div>

        </div>
      ))}
    </div>

    <!-- Mobile swipe indicator prompt -->
    <p class="mt-4 text-center text-xs text-[#1A1A1A]/40 lg:hidden font-medium">
      &larr; Swipe to read more local stories &rarr;
    </p>

  </div>
</section>

<style>
  /* Hide scrollbars on mobile for ultra-clean look */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>