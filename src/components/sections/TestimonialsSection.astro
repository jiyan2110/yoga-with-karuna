---
import { siteConfig } from '../../config/site-content';
---

<section id="reviews" class="py-16 md:py-24 bg-white border-b border-[#A08EB1]/20 scroll-mt-20 overflow-hidden">
  <!-- 🎨 REFINED: Widened container max-w-[1380px] to preserve global alignment -->
  <div class="mx-auto max-w-[1380px] px-4 sm:px-6 md:px-10">
    
    <div class="reveal-on-scroll max-w-2xl mb-10 md:mb-14">
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#832676] mb-3">
        <span>Local Student Proof</span>
      </div>
      <h2 class="font-serif text-3xl font-bold tracking-tight text-[#1E1B5D] sm:text-4xl">
        Real Transformations From Students Who've Experienced Our Online Yoga Community
      </h2>
      <p class="mt-3 text-sm sm:text-base text-[#1E1B5D]/80">Read what women from around the world experience when they join our dedicated online yoga community.</p>
    </div>

    <div class="flex gap-6 overflow-x-auto pb-6 snap-x snap-mandatory lg:grid lg:grid-cols-3 lg:overflow-visible lg:pb-0 no-scrollbar">
      {siteConfig.testimonials.map((review) => (
        <div class="reveal-on-scroll min-w-[280px] sm:min-w-[340px] lg:min-w-0 flex-1 snap-start rounded-[20px] bg-[#FCFDFE] border border-[#A08EB1]/25 p-6 sm:p-8 flex flex-col justify-between shadow-[0_4px_20px_rgba(30,27,93,0.03)] transition-all duration-300 hover:shadow-md hover:-translate-y-1">
          
          <div>
            <div class="flex items-center gap-1 text-[#762A6B] mb-4 text-base">
              {'★'.repeat(5)}
            </div>
            <blockquote class="text-sm sm:text-base leading-relaxed text-[#1E1B5D]/85 italic">
              "{review.reviewText}"
            </blockquote>
          </div>

          <div class="mt-6 pt-4 border-t border-[#A08EB1]/20 flex items-center justify-between">
            <div>
              <p class="font-serif font-bold text-sm text-[#1E1B5D]">{review.studentName}</p>
              <p class="text-[11px] font-semibold text-[#832676]">{review.locality}, Anand</p>
            </div>
            <span class="rounded-full bg-[#A08EB1]/15 px-3 py-1 text-[10px] font-bold text-[#1E1B5D]/70">
              {review.batchJoined}
            </span>
          </div>

        </div>
      ))}
    </div>

    <p class="mt-4 text-center text-xs text-[#1E1B5D]/50 lg:hidden font-semibold">
      &larr; Swipe to read more local stories &rarr;
    </p>

  </div>
</section>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>