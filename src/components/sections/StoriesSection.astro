---
import Icon from '../ui/Icon.astro';
import { siteConfig } from '../../config/site-content';

const stars = 'M10.868 2.884c-.321-.772-1.415-.772-1.736 0l-1.83 4.401-4.753.381c-.833.067-1.171 1.107-.536 1.651l3.62 3.102-1.106 4.637c-.194.813.691 1.456 1.405 1.02L10 15.591l4.069 2.485c.713.436 1.598-.207 1.404-1.02l-1.106-4.637 3.62-3.102c.635-.544.297-1.584-.536-1.65l-4.752-.382-1.831-4.401Z';
---

<section id="stories" class="bg-white py-20 sm:py-28">
  <div class="container-page">
    <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow">Student stories</p>
        <h2 class="mt-4 text-4xl font-semibold sm:text-5xl">What our students say</h2>
      </div>
      <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" class="btn btn-ghost w-fit">
        <Icon name="instagram" class="h-4 w-4 text-plum" />
        More on Instagram
      </a>
    </div>

    <div class="swipe mt-12 grid items-start gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="Student stories, swipe to see more">
      {siteConfig.testimonials.map((t) => (
        <figure class="reveal relative flex flex-col rounded-[var(--radius-card)] bg-sand p-6 ring-1 ring-indigo/8 sm:p-8">
          <div class="flex gap-0.5 text-sun" aria-label="Rated 5 out of 5">
            {Array.from({ length: 5 }).map(() => (
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d={stars} /></svg>
            ))}
          </div>

          {t.reviewText && (
            <div class="story-text mt-5" data-story>
              <span class="pointer-events-none absolute top-4 right-7 font-serif text-8xl leading-none text-plum/15" aria-hidden="true">“</span>
              <blockquote class="story-clamp font-serif text-lg leading-relaxed text-indigo">
                <p>{t.reviewText}</p>
              </blockquote>
              <button type="button" data-story-toggle aria-expanded="false" class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-plum hover:underline">
                <span data-story-label>Read full review</span>
                <Icon name="arrow" class="h-4 w-4" />
              </button>
            </div>
          )}

          {t.video && (
            <div class="mt-5 overflow-hidden rounded-2xl bg-indigo">
              <video
                class="aspect-[4/5] w-full object-contain"
                controls
                playsinline
                preload="none"
                poster={t.video.poster}
                aria-label={`Video review from ${t.studentName}`}
              >
                <source src={t.video.src} type="video/mp4" />
              </video>
            </div>
          )}

          {t.audio && (
            <div class="mt-5">
              <div class="flex items-center gap-3 rounded-2xl bg-white p-4 ring-1 ring-indigo/8">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-plum text-white" aria-hidden="true">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3Z" /><path d="M19 11a7 7 0 0 1-14 0M12 18v3" /></svg>
                </span>
                <audio class="w-full" controls preload="none" aria-label={`Voice note from ${t.studentName}`}>
                  <source src={t.audio.src} type="audio/mp4" />
                </audio>
              </div>
              {t.audio.transcript && (
                <blockquote class="mt-4 font-serif text-lg leading-relaxed text-indigo"><p>{t.audio.transcript}</p></blockquote>
              )}
            </div>
          )}

          <figcaption class="mt-6 flex items-center gap-3.5 border-t border-indigo/10 pt-5">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-plum font-serif text-lg font-semibold text-white" aria-hidden="true">
              {t.studentName.charAt(0)}
            </span>
            <span>
              <span class="block font-semibold text-indigo">{t.studentName}</span>
              <span class="block text-sm text-muted">{t.label}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  /* Long written reviews: show the opening lines, the rest behind "Read full review". */
  .story-clamp {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 9;
    line-clamp: 9;
    overflow: hidden;
  }
  [data-story].is-open .story-clamp { -webkit-line-clamp: unset; line-clamp: unset; overflow: visible; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-story]').forEach((box) => {
    const btn = box.querySelector<HTMLButtonElement>('[data-story-toggle]')!;
    const quote = box.querySelector<HTMLElement>('.story-clamp')!;
    // Hide the button when the review is short enough to show in full.
    if (quote.scrollHeight <= quote.clientHeight + 2) { btn.hidden = true; return; }
    btn.addEventListener('click', () => {
      const open = box.classList.toggle('is-open');
      btn.setAttribute('aria-expanded', String(open));
      box.querySelector('[data-story-label]')!.textContent = open ? 'Show less' : 'Read full review';
    });
  });
</script>
