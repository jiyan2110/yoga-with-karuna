---
import { siteConfig } from '../../config/site-content';
---

<section id="authority" class="py-16 md:py-24 bg-white border-y border-[#4A6B5D]/15 scroll-mt-20">
  <div class="mx-auto max-w-[1200px] px-6">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
      
      <!-- Left Column: Portrait & Authority Highlights -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <!-- Decorative frame element -->
          <div class="absolute -inset-4 rounded-2xl bg-[#4A6B5D]/10 -rotate-2 -z-10" aria-hidden="true"></div>
          
          <div class="aspect-[4/5] rounded-xl bg-[#FAF9F6] border border-[#4A6B5D]/20 p-6 flex flex-col items-center justify-center text-center shadow-md overflow-hidden relative">
            
            <div class="h-24 w-24 rounded-full bg-[#4A6B5D]/15 flex items-center justify-center mb-4 text-4xl">
              🧘
            </div>
            <h3 class="font-serif text-xl font-bold text-[#1A1A1A]">{siteConfig.instructor.name}</h3>
            <p class="text-xs font-semibold text-[#4A6B5D] uppercase tracking-wider mt-1">
              {siteConfig.instructor.title}
            </p>
            <p class="text-xs text-[#1A1A1A]/60 mt-4 px-4">
              [Authority Image Placeholder: High-resolution professional action photo of Karuna executing an advanced posture]
            </p>

            <!-- Bottom badge inside portrait frame -->
            <div class="absolute bottom-0 inset-x-0 bg-[#4A6B5D] py-3 px-4 text-center text-white">
              <p class="text-xs font-semibold tracking-wide">Teaching Offline in {siteConfig.location.city} for 12+ Years</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Biography Copy & Credentials Grid -->
      <div class="lg:col-span-7 lg:pl-6">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#4A6B5D] mb-3">
          <span>Authority & Lineage</span>
        </div>
        
        <h2 class="font-serif text-3xl font-bold tracking-tight text-[#1A1A1A] sm:text-4xl">
          Why Learn Offline From An <span class="text-[#4A6B5D] underline decoration-[#4A6B5D]/30 underline-offset-4">8x World Record Breaker?</span>
        </h2>

        <!-- Bio Paragraphs -->
        <div class="mt-6 space-y-4 text-base leading-relaxed text-[#1A1A1A]/80">
          {siteConfig.instructor.bioParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <!-- Credentials Checklist Grid -->
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 border-t border-black/10">
          {siteConfig.instructor.credentials.map((cred) => (
            <div class="flex items-start gap-3 p-3 rounded-lg bg-[#FAF9F6] border border-[#4A6B5D]/10">
              <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#4A6B5D] text-white text-xs font-bold">
                ✓
              </div>
              <div>
                <p class="text-xs font-bold text-[#1A1A1A]">{cred.title}</p>
                <p class="text-[11px] text-[#1A1A1A]/60 mt-0.5">{cred.issuer}</p>
              </div>
            </div>
          ))}
        </div>

      </div>

    </div>
  </div>
</section>