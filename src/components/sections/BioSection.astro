---
import { siteConfig } from '../../config/site-content';
---

<section id="authority" class="relative py-20 md:py-28 bg-[#832676] text-white scroll-mt-20">
  
  <div class="absolute top-0 inset-x-0 overflow-hidden leading-none pointer-events-none -translate-y-[99%]">
    <svg class="relative block w-full h-8 sm:h-12 md:h-16 text-[#832676]" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
      <path d="M0,0 C150,90 350,-40 500,45 C650,130 900,10 1200,30 L1200,120 L0,120 Z"></path>
    </svg>
  </div>

  <div class="absolute bottom-0 inset-x-0 overflow-hidden leading-none pointer-events-none translate-y-[99%]">
    <svg class="relative block w-full h-8 sm:h-12 md:h-16 text-[#832676]" viewBox="0 0 1200 120" preserveAspectRatio="none" fill="currentColor">
      <path d="M0,120 C150,30 350,160 500,75 C650,-10 900,110 1200,90 L1200,0 L0,0 Z"></path>
    </svg>
  </div>

  <div class="mx-auto max-w-[1380px] px-4 sm:px-6 md:px-10">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
      
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          <div class="absolute -inset-4 rounded-[24px] bg-white/10 -rotate-2 -z-10" aria-hidden="true"></div>
          <div class="aspect-[4/5] rounded-[20px] bg-white border border-white/20 p-6 flex flex-col items-center justify-center text-center shadow-xl overflow-hidden relative">
            <div class="h-24 w-24 rounded-full bg-[#832676]/10 flex items-center justify-center mb-4 text-4xl">
              🧘
            </div>
            <h3 class="font-serif text-xl font-bold text-[#1E1B5D]">{siteConfig.instructor.name}</h3>
            <p class="text-xs font-semibold text-[#832676] uppercase tracking-wider mt-1">
              {siteConfig.instructor.title}
            </p>
            <p class="text-xs text-[#1E1B5D]/70 mt-4 px-4">
              [Authority Image Placeholder]
            </p>
            <div class="absolute bottom-0 inset-x-0 bg-[#1E1B5D] py-3 px-4 text-center text-white">
              <p class="text-xs font-semibold tracking-wide">Empowering Women Globally for {siteConfig.instructor.experienceYears} Years</p>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7 lg:pl-6">
        <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#A08EB1] mb-3">
          <span>Our Philosophy</span>
        </div>
        
        <h2 class="font-serif text-3xl font-bold tracking-tight text-white sm:text-4xl">
          Ancient Wisdom for the <span class="text-[#A08EB1] underline decoration-[#A08EB1]/40 underline-offset-4">Modern Woman.</span>
        </h2>

        <div class="mt-6 space-y-4 text-base leading-relaxed text-white/90">
          {siteConfig.instructor.bioParagraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 border-t border-white/15">
          {siteConfig.instructor.credentials.map((cred) => (
            <div class="flex items-start gap-3 p-3.5 rounded-[16px] bg-white/10 border border-white/15 shadow-sm backdrop-blur-sm">
              <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-white text-[#832676] text-xs font-bold">
                ✓
              </div>
              <div>
                <p class="text-xs font-bold text-white">{cred.title}</p>
                <p class="text-[11px] text-white/70 mt-0.5">{cred.issuer}</p>
              </div>
            </div>
          ))}
        </div>

      </div>

    </div>
  </div>
</section>