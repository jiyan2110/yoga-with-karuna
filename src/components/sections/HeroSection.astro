---
import { Picture } from 'astro:assets';
import sunrise from '../../assets/hero-sunrise.webp';
import Icon from '../ui/Icon.astro';
import { siteConfig, whatsappLink, type HeroCopy } from '../../config/site-content';

interface Props {
  /** Overrides the headline and intro (handy for previewing other wording). */
  copy?: HeroCopy;
}
const { brand, hero, instructor } = siteConfig;
const headline = Astro.props.copy?.headline ?? hero.headline;
const intro = Astro.props.copy?.intro ?? hero.intro;
const firstClass = siteConfig.classes[0];
---

<section id={Astro.props.copy ? undefined : 'top'} class="relative isolate overflow-hidden">
  <!-- soft brand glow -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-40 -left-32 h-[34rem] w-[34rem] rounded-full bg-lilac/50 blur-3xl"></div>
    <div class="absolute top-24 -right-40 h-[30rem] w-[30rem] rounded-full bg-sun/25 blur-3xl"></div>
  </div>

  <div class="container-page grid items-center gap-12 pt-8 pb-16 sm:pt-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:pt-16 lg:pb-24">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-plum/15 bg-white/70 px-3.5 py-1.5 text-[0.8rem] font-semibold text-plum shadow-sm">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-plum/50"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-plum"></span>
        </span>
        {brand.audience}
      </p>

      <p class="mt-6 font-deva text-2xl text-plum sm:text-3xl" lang="sa">
        {brand.sanskrit}
        <span class="ml-2 align-middle font-sans text-sm font-medium italic text-muted" lang="en">“{brand.sanskritMeaning}”</span>
      </p>

      <h1 class="mt-3 text-[2.6rem] leading-[1.08] font-semibold sm:text-6xl lg:text-[4.1rem]">
        {headline.lead} <em class="font-medium text-plum">{headline.emphasis}</em>
      </h1>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted sm:mt-6 sm:text-lg">
        <strong class="font-semibold text-indigo">{hero.greeting}!</strong> {intro}
      </p>
      <p class="mt-3 hidden max-w-xl text-base leading-relaxed text-muted sm:block sm:text-lg">{hero.support}</p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          <Icon name="whatsapp" class="h-5 w-5" />
          Book a class on WhatsApp
        </a>
        <a href="#classes" class="btn btn-ghost">
          See class timings
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>

      <p class="mt-8 flex items-center gap-3 font-serif text-xl text-indigo/80 italic">
        {brand.mantra.map((word, i) => (
          <>
            {i > 0 && <span class="h-1.5 w-1.5 rounded-full bg-sun" aria-hidden="true"></span>}
            <span>{word}</span>
          </>
        ))}
      </p>

      <dl class="mt-10 grid max-w-lg grid-cols-3 gap-4 border-t border-indigo/10 pt-6">
        <div>
          <dt class="text-xs font-medium text-muted">Teaching</dt>
          <dd class="font-serif text-2xl font-semibold text-indigo sm:text-3xl">{instructor.experienceYears} yrs</dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-muted">Students guided</dt>
          <dd class="font-serif text-2xl font-semibold text-indigo sm:text-3xl">{instructor.studentsGuided}</dd>
        </div>
        <div>
          <dt class="text-xs font-medium text-muted">Classes</dt>
          <dd class="font-serif text-2xl font-semibold text-indigo sm:text-3xl">6 days</dd>
        </div>
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-md lg:max-w-none">
      <div class="relative overflow-hidden rounded-t-[999px] rounded-b-[2rem] shadow-lift ring-8 ring-white/70">
        <Picture
          src={sunrise}
          formats={['avif']}
          fallbackFormat="webp"
          quality={72}
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 40vw, (min-width: 640px) 28rem, 90vw"
          alt="A woman meditating with arms raised towards the sunrise over misty hills"
          class="aspect-[4/5] h-full w-full object-cover object-[78%_50%]"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-indigo/40 to-transparent"></div>
      </div>

      <div class="absolute -bottom-6 left-1/2 w-[86%] -translate-x-1/2 rounded-2xl bg-white/95 p-4 shadow-soft backdrop-blur sm:left-auto sm:-left-6 sm:w-auto sm:translate-x-0">
        <p class="text-[0.7rem] font-bold tracking-[0.14em] text-plum uppercase">Daily evening batch</p>
        <p class="mt-1 font-serif text-lg font-semibold text-indigo">{firstClass.shortName}</p>
        <p class="mt-0.5 flex items-center gap-1.5 text-sm text-muted">
          <Icon name="clock" class="h-4 w-4 text-plum" />
          {firstClass.days} · {firstClass.time} IST
        </p>
      </div>

      <div class="absolute top-8 -right-2 hidden items-center gap-2 rounded-full bg-white/95 px-4 py-2 text-sm font-semibold text-indigo shadow-soft sm:flex">
        <Icon name="video" class="h-4 w-4 text-plum" />
        Live on Google Meet / Zoom
      </div>
    </div>
  </div>
</section>
