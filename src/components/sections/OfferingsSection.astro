---
import { siteConfig } from '../../config/site-content';
import ClassCard from '../ui/ClassCard.astro';
---

<section id="offerings" class="py-16 md:py-24 bg-[#FCFDFE] scroll-mt-20">
  <div class="mx-auto max-w-[1380px] px-4 sm:px-6 md:px-10">
    
    <div class="reveal-on-scroll max-w-2xl mx-auto text-center mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#832676] mb-3">
        <span class="h-px w-6 bg-[#832676]"></span>
        <!-- 🎨 REFINED: Changed "Studio" to "Class" -->
        <span>Daily Class Schedule</span>
        <span class="h-px w-6 bg-[#832676]"></span>
      </div>
      <!-- 🎨 REFINED: Simplified and Captivating H2 -->
      <h2 class="font-serif text-3xl font-bold tracking-tight text-[#1E1B5D] sm:text-4xl">
        Find Your Perfect Online Yoga Class
      </h2>
      <p class="mt-4 text-sm sm:text-base text-[#1E1B5D]/80">
        Choose a dedicated time for your personal wellness. All classes are conducted live online via Google Meet with hands-on posture guidance and personal supervision.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 items-stretch">
      {siteConfig.classes.map((offering) => (
        <ClassCard offering={offering} />
      ))}
    </div>

  </div>
</section>