---
import { Image } from 'astro:assets';
import logo from '../../assets/logo-footer.png';
import Icon from '../ui/Icon.astro';
import { siteConfig, whatsappLink } from '../../config/site-content';

const { contact, social, brand } = siteConfig;
const year = new Date().getFullYear();
const linkClass = 'text-white/80 transition-colors hover:text-white';
---

<footer class="bg-plum-deep pt-16 pb-28 text-white sm:pb-12">
  <div class="container-page grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.3fr]">
    <div>
      <a href="/#top" class="inline-block" aria-label={`${brand.name}, back to top`}>
        <Image src={logo} alt="" width={230} densities={[1, 2]} class="h-auto w-[230px]" />
      </a>
      <p class="mt-5 max-w-xs leading-relaxed text-white/75">{brand.tagline}. Live online yoga for women, from wherever you are.</p>
      <div class="mt-6 flex gap-2">
        <a href={social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20">
          <Icon name="instagram" class="h-5 w-5" />
        </a>
        <a href={social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20">
          <Icon name="facebook" class="h-5 w-5" />
        </a>
        <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 transition hover:bg-white/20">
          <Icon name="whatsapp" class="h-5 w-5" />
        </a>
      </div>
    </div>

    <nav aria-label="Quick links">
      <h2 class="font-sans text-sm font-bold tracking-[0.14em] !text-lilac uppercase">Quick links</h2>
      <ul class="mt-5 space-y-1">
        {siteConfig.nav.map((l) => <li><a href={l.href} class={`inline-block py-1.5 ${linkClass}`}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav aria-label="Our classes">
      <h2 class="font-sans text-sm font-bold tracking-[0.14em] !text-lilac uppercase">Our classes</h2>
      <ul class="mt-5 space-y-1">
        {siteConfig.classes.map((c) => <li><a href={`/#${c.id}`} class={`inline-block py-1.5 ${linkClass}`}>{c.shortName}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="font-sans text-sm font-bold tracking-[0.14em] !text-lilac uppercase">Contact</h2>
      <ul class="mt-5 space-y-3">
        <li>
          <a href={`tel:${contact.phoneE164}`} class={`inline-flex items-center gap-3 py-1 ${linkClass}`}>
            <Icon name="phone" class="h-5 w-5 text-lilac" /> {contact.phoneDisplay}
          </a>
        </li>
        <li>
          <a href={`mailto:${contact.email}`} class={`inline-flex items-center gap-3 py-1 break-all ${linkClass}`}>
            <Icon name="mail" class="h-5 w-5 shrink-0 text-lilac" /> {contact.email}
          </a>
        </li>
        <li class="inline-flex items-center gap-3 py-1 text-white/80">
          <Icon name="video" class="h-5 w-5 text-lilac" /> Live online classes (IST)
        </li>
      </ul>
    </div>
  </div>

  <div class="container-page mt-14 flex flex-col gap-2 border-t border-white/10 pt-6 text-sm text-white/60 sm:flex-row sm:justify-between">
    <p>© {year} {brand.name}. All rights reserved.</p>
    <p>Classes for women only · Timings in IST</p>
  </div>
</footer>
