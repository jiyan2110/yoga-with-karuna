---
import { siteConfig } from '../../config/site-content';

const encodedWaMessage = encodeURIComponent(siteConfig.whatsapp.defaultDraft);
const whatsappUrl = `https://wa.me/${siteConfig.whatsapp.phoneDigits}?text=${encodedWaMessage}`;
---

<header class="sticky top-0 z-50 w-full bg-[#FAF9F6]/90 backdrop-blur-md border-b border-[#4A6B5D]/15 transition-all duration-200">
  <div class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-4 md:py-5">
    
    <!-- Brand Wordmark -->
    <a 
      href="#" 
      class="flex flex-col focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#4A6B5D]"
      aria-label="Yoga with Karuna Home"
    >
      <span class="font-serif text-xl font-bold tracking-tight text-[#1A1A1A] md:text-2xl">
        {siteConfig.brand.name}
      </span>
      <span class="text-[10px] font-medium tracking-widest uppercase text-[#4A6B5D] -mt-1 hidden sm:block">
        {siteConfig.location.city} Studio
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex md:items-center md:gap-8" aria-label="Main Navigation">
      <ul class="flex items-center gap-8 text-sm font-medium text-[#1A1A1A]/80">
        {siteConfig.nav.map((link) => (
          <li>
            <a 
              href={link.href} 
              class="transition-colors duration-150 hover:text-[#4A6B5D] focus-visible:outline-2 focus-visible:outline-[#4A6B5D]"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <!-- Navbar Direct Conversion Hook -->
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-lg bg-[#25D366] px-4 py-2.5 text-xs font-semibold text-white shadow-sm transition-all duration-200 hover:bg-[#20ba5a] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#25D366] active:scale-95"
      >
        <span>Message Karuna</span>
      </a>
    </nav>

    <!-- Mobile Hamburger Trigger -->
    <button
      type="button"
      id="mobile-menu-btn"
      class="inline-flex items-center justify-center rounded-md p-2 text-[#1A1A1A] hover:bg-[#4A6B5D]/10 focus-visible:outline-2 focus-visible:outline-[#4A6B5D] md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <svg class="h-6 w-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.75">
        <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>

  </div>

  <!-- Mobile Dropdown Drawer -->
  <div id="mobile-menu" class="hidden border-b border-[#4A6B5D]/15 bg-[#FAF9F6] px-6 py-6 md:hidden shadow-xl" role="region" aria-label="Mobile Menu">
    <ul class="flex flex-col gap-4 text-base font-medium text-[#1A1A1A]">
      {siteConfig.nav.map((link) => (
        <li>
          <a 
            href={link.href} 
            class="mobile-nav-link block py-1 hover:text-[#4A6B5D]"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-4 mt-2 border-t border-black/5">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center gap-2 rounded-xl bg-[#25D366] py-3.5 text-sm font-semibold text-white shadow-md"
        >
          <span>Chat on WhatsApp</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Pure Vanilla UI controller scoped strictly to Astro instance
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  const toggleMenu = () => {
    const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
    menuBtn?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
  };

  menuBtn?.addEventListener('click', toggleMenu);

  // Auto-close drawer when a mobile user taps an anchor link
  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>