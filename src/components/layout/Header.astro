---
import { siteConfig } from '../../config/site-content';

const encodedWaMessage = encodeURIComponent(siteConfig.whatsapp.defaultDraft);
const whatsappUrl = `https://wa.me/${siteConfig.whatsapp.phoneDigits}?text=${encodedWaMessage}`;
---

<header class="sticky top-0 z-50 w-full bg-white border-b border-[#A08EB1]/20 shadow-[0_2px_15px_rgba(30,27,93,0.03)] transition-all duration-200">
  
  <!-- Top Contact & Social Strip -->
  <div class="bg-[#832676] text-white py-2 px-4 sm:px-6 md:px-10 text-xs font-medium">
    <div class="mx-auto flex max-w-[1380px] items-center justify-between">
      
      <!-- Left: Email Address -->
      <div class="flex items-center gap-2">
        <svg class="h-3.5 w-3.5 shrink-0 fill-current" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z" />
          <path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z" />
        </svg>
        <a href="mailto:contact@yogawithkaruna.com" class="hover:underline text-white transition-opacity hover:opacity-80">
          contact@yogawithkaruna.com
        </a>
      </div>

      <!-- Right: Minimalist, Uniformly Sized Social Icons -->
      <div class="flex items-center gap-4">
        <!-- Instagram (Simple Icons) -->

        <a href={siteConfig.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-white hover:text-[#D8CDE3] transition-colors">
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" role="img" xmlns="http://www.w3.org/2000/svg">
            <title>Instagram</title>
            <path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.012 8.333 0 8.74 0 12s.015 3.667.072 4.947c.06 1.277.261 2.148.558 2.913a5.885 5.885 0 0 0 1.384 2.126A5.868 5.868 0 0 0 4.14 23.37c.766.296 1.636.499 2.913.558C8.333 23.988 8.74 24 12 24s3.667-.015 4.947-.072c1.277-.06 2.148-.262 2.913-.558a5.898 5.898 0 0 0 2.126-1.384 5.86 5.86 0 0 0 1.384-2.126c.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.015-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913a5.89 5.89 0 0 0-1.384-2.126A5.847 5.847 0 0 0 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.012 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227a3.81 3.81 0 0 1-.899 1.382 3.744 3.744 0 0 1-1.38.896c-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421a3.716 3.716 0 0 1-1.379-.899 3.644 3.644 0 0 1-.9-1.38c-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.757 6.162 6.162 6.162 3.405 0 6.162-2.757 6.162-6.162 0-3.402-2.757-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405a1.441 1.441 0 0 1-2.88 0 1.44 1.44 0 0 1 2.88 0z"/>
          </svg>
        </a>
        <!-- Facebook (Simple Icons) -->
        <a href={siteConfig.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-white hover:text-[#D8CDE3] transition-colors">
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" role="img" xmlns="http://www.w3.org/2000/svg">
            <title>Facebook</title>
            <path d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/>
          </svg>
        </a>
        <!-- WhatsApp (Simple Icons) -->
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-white hover:text-[#D8CDE3] transition-colors">
          <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" role="img" xmlns="http://www.w3.org/2000/svg">
            <title>WhatsApp</title>
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
        </a>
      </div>

    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="mx-auto flex max-w-[1380px] items-center justify-between px-4 sm:px-6 md:px-10 py-4 md:py-5">
    
    <a 
      href="#" 
      class="flex items-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#832676]"
      aria-label="Yoga with Karuna Home"
    >
      <img 
        src="/assets/images/logo.png" 
        alt={siteConfig.brand.name} 
        class="h-10 sm:h-12 w-auto object-contain"
      />
    </a>

    <nav class="hidden md:flex md:items-center md:gap-8" aria-label="Main Navigation">
      <ul class="flex items-center gap-8 text-sm font-medium text-[#1E1B5D]">
        {siteConfig.nav.map((link) => (
          <li>
            <a 
              href={link.href} 
              class="nav-link relative py-1 text-[#1E1B5D] transition-colors duration-200 hover:text-[#832676] after:absolute after:bottom-0 after:left-0 after:h-[2px] after:w-0 after:bg-[#832676] hover:after:w-full after:transition-all after:duration-300 focus-visible:outline-2 focus-visible:outline-[#832676]"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-[14px] bg-[#832676] px-5 py-2.5 text-xs font-semibold text-white shadow-[0_2px_10px_rgba(131,38,118,0.2)] transition-all duration-200 hover:bg-[#1E1B5D] hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#832676] active:scale-95"
      >
        <span>Message Karuna</span>
      </a>
    </nav>

    <button
      type="button"
      id="mobile-menu-btn"
      class="inline-flex items-center justify-center rounded-md p-2 text-[#1E1B5D] hover:bg-[#A08EB1]/10 focus-visible:outline-2 focus-visible:outline-[#832676] md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
      aria-label="Toggle navigation menu"
    >
      <svg class="h-6 w-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.75">
        <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
      </svg>
    </button>

  </div>

  <!-- Mobile Dropdown Drawer -->
  <div id="mobile-menu" class="hidden border-b border-[#A08EB1]/20 bg-white px-6 py-6 md:hidden shadow-xl" role="region" aria-label="Mobile Menu">
    <ul class="flex flex-col gap-4 text-base font-medium text-[#1E1B5D]">
      {siteConfig.nav.map((link) => (
        <li>
          <a 
            href={link.href} 
            class="mobile-nav-link block py-1.5 text-[#1E1B5D] hover:text-[#832676]"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li class="pt-4 mt-2 border-t border-[#A08EB1]/20">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center gap-2 rounded-[14px] bg-[#832676] py-3.5 text-sm font-semibold text-white shadow-md hover:bg-[#1E1B5D] transition-colors"
        >
          <span>Chat on WhatsApp</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  const toggleMenu = () => {
    const isExpanded = menuBtn?.getAttribute('aria-expanded') === 'true';
    menuBtn?.setAttribute('aria-expanded', (!isExpanded).toString());
    mobileMenu?.classList.toggle('hidden');
  };

  menuBtn?.addEventListener('click', toggleMenu);

  mobileLinks.forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>