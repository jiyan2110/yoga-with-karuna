---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import Icon from '../ui/Icon.astro';
import { siteConfig, whatsappLink } from '../../config/site-content';
---

<header id="site-header" class="sticky top-0 z-50 border-b border-transparent bg-sand/85 backdrop-blur-md transition-[border-color,box-shadow] duration-300">
  <div class="container-page flex h-[4.5rem] items-center justify-between gap-4">
    <a href="/#top" class="shrink-0 rounded-lg" aria-label={`${siteConfig.brand.name}, back to top`}>
      <Image src={logo} alt="" width={124} densities={[1, 2]} class="h-auto w-[112px] sm:w-[124px]" loading="eager" fetchpriority="high" />
    </a>

    <nav class="hidden lg:block" aria-label="Main">
      <ul class="flex items-center gap-1">
        {siteConfig.nav.map((link) => (
          <li>
            <a href={link.href} class="rounded-full px-4 py-2 text-[0.94rem] font-medium text-ink/80 transition-colors hover:bg-plum-soft hover:text-plum">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="btn btn-primary hidden !min-h-11 !px-5 !text-sm sm:inline-flex">
        <Icon name="whatsapp" class="h-4 w-4" />
        Book a class
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full text-indigo transition-colors hover:bg-plum-soft lg:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Open menu</span>
        <span data-icon="open"><Icon name="menu" class="h-6 w-6" /></span>
        <span data-icon="close" class="hidden"><Icon name="close" class="h-6 w-6" /></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-indigo/10 bg-sand lg:hidden">
    <nav class="container-page py-4" aria-label="Mobile">
      <ul class="flex flex-col">
        {siteConfig.nav.map((link) => (
          <li>
            <a href={link.href} class="menu-link flex items-center justify-between rounded-xl px-3 py-3.5 text-lg font-medium text-indigo hover:bg-plum-soft">
              {link.label}
              <Icon name="arrow" class="h-4 w-4 text-plum/60" />
            </a>
          </li>
        ))}
      </ul>
      <a href={whatsappLink()} target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-4 w-full">
        <Icon name="whatsapp" class="h-5 w-5" />
        Chat with Karuna on WhatsApp
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('.sr-only')!.textContent = open ? 'Close menu' : 'Open menu';
    toggle.querySelector('[data-icon="open"]')?.classList.toggle('hidden', open);
    toggle.querySelector('[data-icon="close"]')?.classList.toggle('hidden', !open);
    menu.classList.toggle('hidden', !open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu?.querySelectorAll('.menu-link').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));

  const onScroll = () => {
    const scrolled = window.scrollY > 8;
    header?.classList.toggle('border-indigo/10', scrolled);
    header?.classList.toggle('shadow-[0_6px_24px_-12px_rgb(30_27_93/0.25)]', scrolled);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
