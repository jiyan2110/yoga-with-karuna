---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ClassesSection from '../components/sections/ClassesSection.astro';
import JoinSection from '../components/sections/JoinSection.astro';
import StoriesSection from '../components/sections/StoriesSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import FloatingWhatsApp from '../components/ui/FloatingWhatsApp.astro';
---

<Layout>
  <Header />
  <main id="main-content">
    <HeroSection />
    <AboutSection />
    <ClassesSection />
    <JoinSection />
    <StoriesSection />
    <FaqSection />
    <ContactSection />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Layout>

<script>
  // Reveal sections as they scroll into view (styles in global.css; skipped for reduced motion).
  const els = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
    els.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      }),
      { rootMargin: '0px 0px -8% 0px', threshold: 0.01 },
    );
    els.forEach((el) => io.observe(el));
    // Jumping via the menu: reveal the target section straight away so it is never blank.
    addEventListener('hashchange', () => {
      document.querySelector(location.hash)?.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
    });
  }

  // Mobile swipe rows: add a dot per card and keep the current one highlighted.
  document.querySelectorAll<HTMLElement>('.swipe').forEach((row) => {
    const cards = Array.from(row.children) as HTMLElement[];
    if (cards.length < 2) return;
    const dots = document.createElement('div');
    dots.className = 'swipe-dots';
    const buttons = cards.map((card, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', `Show card ${i + 1} of ${cards.length}`);
      b.addEventListener('click', () => row.scrollTo({ left: card.offsetLeft - row.offsetLeft - (row.clientWidth - card.clientWidth) / 2, behavior: 'smooth' }));
      dots.append(b);
      return b;
    });
    row.after(dots);
    const update = () => {
      const mid = row.scrollLeft + row.clientWidth / 2;
      let best = 0;
      cards.forEach((c, i) => {
        if (Math.abs(c.offsetLeft - row.offsetLeft + c.clientWidth / 2 - mid) < Math.abs(cards[best].offsetLeft - row.offsetLeft + cards[best].clientWidth / 2 - mid)) best = i;
      });
      buttons.forEach((b, i) => b.setAttribute('aria-current', String(i === best)));
    };
    row.addEventListener('scroll', update, { passive: true });
    update();
  });
</script>
