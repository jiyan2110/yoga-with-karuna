---
import Layout from '../layouts/Layout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import AboutSection from '../components/sections/AboutSection.astro';
import ClassesSection from '../components/sections/ClassesSection.astro';
import JoinSection from '../components/sections/JoinSection.astro';
import StoriesSection from '../components/sections/StoriesSection.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
import FloatingWhatsApp from '../components/ui/FloatingWhatsApp.astro';
---

<Layout>
  <Header />
  <main id="main-content">
    <HeroSection />
    <AboutSection />
    <ClassesSection />
    <JoinSection />
    <StoriesSection />
    <FaqSection />
    <ContactSection />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Layout>

<script>
  // Reveal sections as they scroll into view (styles in global.css; skipped for reduced motion).
  const els = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
    els.forEach((el) => el.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      }),
      { rootMargin: '0px 0px -8% 0px', threshold: 0.01 },
    );
    els.forEach((el) => io.observe(el));
    // Jumping via the menu: reveal the target section straight away so it is never blank.
    addEventListener('hashchange', () => {
      document.querySelector(location.hash)?.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
    });
  }

  // Mobile swipe rows: arrows, a dot per card and a hint; pauses video/audio on cards swiped away.
  const arrow = (d: string) => `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
  document.querySelectorAll<HTMLElement>('.swipe').forEach((row) => {
    const cards = Array.from(row.children) as HTMLElement[];
    if (cards.length < 2) return;
    const nav = document.createElement('div');
    nav.className = 'swipe-nav';
    nav.innerHTML = `
      <div class="swipe-row">
        <button type="button" class="swipe-arrow" data-dir="-1" aria-label="Previous">${arrow('M15 18l-6-6 6-6')}</button>
        <div class="swipe-dots"></div>
        <button type="button" class="swipe-arrow" data-dir="1" aria-label="Next">${arrow('M9 18l6-6-6-6')}</button>
      </div>
      <p class="swipe-hint">${arrow('M5 12h14M13 6l6 6-6 6')} Swipe to see more</p>`;
    const dots = nav.querySelector('.swipe-dots')!;
    const [prev, next] = Array.from(nav.querySelectorAll<HTMLButtonElement>('.swipe-arrow'));
    let current = 0;
    const go = (i: number) => {
      const card = cards[Math.max(0, Math.min(cards.length - 1, i))];
      row.scrollTo({ left: card.offsetLeft - row.offsetLeft - parseFloat(getComputedStyle(row).paddingLeft), behavior: 'smooth' });
    };
    const buttons = cards.map((_, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('aria-label', `Show card ${i + 1} of ${cards.length}`);
      b.addEventListener('click', () => go(i));
      dots.append(b);
      return b;
    });
    prev.addEventListener('click', () => go(current - 1));
    next.addEventListener('click', () => go(current + 1));
    row.after(nav);
    const update = () => {
      const i = Math.round(row.scrollLeft / (cards[1].offsetLeft - cards[0].offsetLeft));
      if (i !== current) {
        cards[current]?.querySelectorAll<HTMLMediaElement>('video, audio').forEach((m) => m.pause());
        current = Math.max(0, Math.min(cards.length - 1, i));
      }
      buttons.forEach((b, k) => b.setAttribute('aria-current', String(k === current)));
      prev.disabled = current === 0;
      next.disabled = current === cards.length - 1;
    };
    row.addEventListener('scroll', update, { passive: true });
    update();
  });
</script>
